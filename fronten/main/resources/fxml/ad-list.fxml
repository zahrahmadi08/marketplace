<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ap.marketplace.client.controller.AdListController">
    <top>
        <VBox>
            <!-- نوار عملیات -->
            <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="8">
                <Label text="سامانه آگهی دست دوم" styleClass="subtitle"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="ثبت آگهی" onAction="#onCreate" styleClass="primary"/>
                <Button text="آگهی‌های من" onAction="#onMine"/>
                <Button text="علاقه‌مندی‌ها" onAction="#onFavorites"/>
                <Button text="گفت‌وگوها" onAction="#onChats"/>
                <Button fx:id="adminButton" text="پنل ادمین" onAction="#onAdmin"/>
                <Button text="خروج" onAction="#onLogout" styleClass="danger"/>
            </HBox>
            <!-- نوار فیلتر و جست‌وجو -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <padding><Insets top="10" right="12" bottom="10" left="12"/></padding>
                <TextField fx:id="searchField" promptText="جست‌وجو در عنوان/توضیحات" prefWidth="220"/>
                <ComboBox fx:id="typeCombo" promptText="نوع"/>
                <ComboBox fx:id="categoryCombo" promptText="دسته"/>
                <ComboBox fx:id="cityCombo" promptText="شهر"/>
                <TextField fx:id="minPriceField" promptText="حداقل قیمت" prefWidth="110"/>
                <TextField fx:id="maxPriceField" promptText="حداکثر قیمت" prefWidth="110"/>
                <ComboBox fx:id="sortCombo" promptText="مرتب‌سازی"/>
                <Button text="اعمال" onAction="#onSearch" styleClass="primary"/>
                <Button text="پاک‌کردن" onAction="#onReset"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <ListView fx:id="adList">
            <BorderPane.margin><Insets top="8" right="12" bottom="8" left="12"/></BorderPane.margin>
        </ListView>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="12">
            <padding><Insets top="8" right="12" bottom="12" left="12"/></padding>
            <Button text="صفحه قبل" onAction="#onPrevPage"/>
            <Label fx:id="pageLabel" text="صفحه ۱"/>
            <Button text="صفحه بعد" onAction="#onNextPage"/>
        </HBox>
    </bottom>
</BorderPane>
