<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ap.marketplace.client.controller.AdminController">
    <top>
        <VBox>
            <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="8">
                <Button text="بازگشت" onAction="#onBack"/>
                <Label text="پنل مدیریت" styleClass="subtitle"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="بروزرسانی" onAction="#onRefresh"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <padding><Insets top="10" right="12" bottom="4" left="12"/></padding>
                <Label fx:id="statUsers" styleClass="badge"/>
                <Label fx:id="statAds" styleClass="badge"/>
                <Label fx:id="statPending" styleClass="badge"/>
                <Label fx:id="statActive" styleClass="badge"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="آگهی‌های در انتظار">
                <ListView fx:id="pendingList"/>
            </Tab>
            <Tab text="کاربران">
                <ListView fx:id="userList"/>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
