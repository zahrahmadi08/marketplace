<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ap.marketplace.client.controller.AdDetailController">
    <top>
        <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="8">
            <Button text="بازگشت" onAction="#onBack"/>
            <Label fx:id="titleLabel" text="جزئیات آگهی" styleClass="subtitle"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="12">
                <padding><Insets top="14" right="18" bottom="14" left="18"/></padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="typeBadge" styleClass="badge"/>
                    <Label fx:id="statusBadge" styleClass="badge"/>
                    <Pane HBox.hgrow="ALWAYS"/>
                    <Label fx:id="priceLabel" styleClass="price"/>
                </HBox>

                <Label fx:id="metaLabel" style="-fx-text-fill:#6b7280;"/>
                <Label fx:id="typeSummaryLabel" wrapText="true"/>
                <Separator/>
                <Label text="توضیحات" styleClass="subtitle"/>
                <Label fx:id="descriptionLabel" wrapText="true"/>
                <Separator/>

                <Label text="اطلاعات فروشنده" styleClass="subtitle"/>
                <Label fx:id="sellerLabel"/>

                <!-- عملیات -->
                <HBox spacing="8" fx:id="actionBar">
                    <Button fx:id="favoriteButton" text="افزودن به علاقه‌مندی" onAction="#onToggleFavorite"/>
                    <Button fx:id="chatButton" text="گفت‌وگو با فروشنده" onAction="#onChat" styleClass="primary"/>
                    <Button fx:id="soldButton" text="علامت فروخته‌شده" onAction="#onMarkSold"/>
                    <Button fx:id="deleteButton" text="حذف آگهی" onAction="#onDelete" styleClass="danger"/>
                </HBox>

                <Separator/>
                <!-- امتیازدهی -->
                <Label text="امتیازها" styleClass="subtitle"/>
                <HBox spacing="8" alignment="CENTER_LEFT" fx:id="rateBar">
                    <ComboBox fx:id="scoreCombo" promptText="امتیاز"/>
                    <TextField fx:id="commentField" promptText="نظر (اختیاری)" prefWidth="360"/>
                    <Button text="ثبت امتیاز" onAction="#onRate" styleClass="primary"/>
                </HBox>
                <ListView fx:id="ratingList" prefHeight="180"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
